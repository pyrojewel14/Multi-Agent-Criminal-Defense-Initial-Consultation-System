.venv/

data/*
!data/law_knowledge/
data/law_knowledge/*
!data/law_knowledge/criminal_law_chapters.json
logs/
*.log
*.db
*.sqlite
*.sqlite3
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
