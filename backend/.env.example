# ==============================================
# JWT 认证（复制为 .env 后必须替换密钥）
# ==============================================
# 可用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成。
JWT_SECRET_KEY="CHANGE_ME_IN_PRODUCTION"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================
# 聊天模型：OLLAMA 或 ALIYUN
# ==============================================
# 本地首次启动推荐 OLLAMA；容器访问宿主机 Ollama 时由 Compose 覆盖地址。
LLM_TYPE="OLLAMA"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL_NAME="qwen3.5:0.8b"

# ALIYUN 模式填写一个 API key。DASHSCOPE_API_KEY 是兼容别名，通常留空。
ALIYUN_ACCESS_KEY_SECRET=""
DASHSCOPE_API_KEY=""
ALIYUN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_BASE_URL=""
ALIYUN_MODEL_NAME="qwen3-max"

# ==============================================
# Embedding：OLLAMA 或 ALIYUN
# ==============================================
EMBED_MODEL_TYPE="OLLAMA"
# 源码实际读取 TEXT_EMBEDDING_MODEL_NAME；使用 Ollama 前需提前 pull。
TEXT_EMBEDDING_MODEL_NAME="qwen3-embedding:0.6b"
ALIYUN_EMBED_MODEL_NAME="text-embedding-v4"

# ==============================================
# Re-ranker（本地模型，不随 Docker 镜像分发）
# ==============================================
RERANKER_MODEL_PATH="./data/models/Qwen/Qwen3-Reranker-0.6B"
RERANKER_MODEL_NAME="Qwen/Qwen3-Reranker-0.6B"
MODEL_CACHE_DIR="./data/models"
RERANKER_MAX_LENGTH=512
RERANKER_INSTRUCTION=""

# ==============================================
# Redis（后端 lifespan 的硬依赖）
# ==============================================
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_DB=3
REDIS_PASSWORD=""
REDIS_MAX_CONNECTIONS=50

# ==============================================
# SQLite 与 Chroma 持久化
# ==============================================
DATABASE_PATH="./data/chat_history.db"
CHROMA_PERSIST_DIRECTORY="data/chromadb"
CHROMA_COLLECTION_NAME="rag_collection"
CHROMA_MD5_STORE="data/md5_hex_store/md5_hex_store.txt"

# ==============================================
# 日志
# ==============================================
LOG_LEVEL="INFO"
# 示例：LLMGateway=DEBUG,Orchestrator=DEBUG；留空则不单独覆盖模块级别。
LOG_LEVEL_MODULES=""
